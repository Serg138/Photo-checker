# Keep Photos in Git, but never add its contents.
/Photos/*
!/Photos/.gitkeep

# Local fingerprints, settings and reports.
/PhotoCheckerData/

# Generated fixtures, test reports and UI renders.
/tools/photo-checker/test-output*/
/tools/photo-checker/ui-test/

# Photos / raster images anywhere in the project (case-insensitive extensions).
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[jJ][pP][eE]
*.[jJ][fF][iI][fF]
*.[pP][nN][gG]
*.[bB][mM][pP]
*.[gG][iI][fF]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[wW][eE][bB][pP]
*.[aA][vV][iI][fF]
*.[jJ][xX][lL]
*.[rR][aA][wW]
*.[dD][nN][gG]
*.[cC][rR]2
*.[cC][rR]3
*.[nN][eE][fF]
*.[aA][rR][wW]
*.[oO][rR][fF]
*.[rR][wW]2
*.[rR][aA][fF]
*.[pP][eE][fF]
*.[sS][rR][wW]

# Build / editor leftovers. The ready-to-run PhotoChecker.exe is tracked.
*.pdb
*.tmp
*.tmp-*
.vs/
bin/
obj/
Thumbs.db
Desktop.ini
